# Copy this file to .env and fill in the values for your environment.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Copy the PostgreSQL URI from Supabase Connect > Session pooler.
# Replace the password placeholder with your URL-encoded database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# For offline local development only:
# DATABASE_URL=sqlite:///db.sqlite3
